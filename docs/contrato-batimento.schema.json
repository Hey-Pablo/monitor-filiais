{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cpu", "memoria", "disco", "servicos", "latencia"],
  "properties": {
    "cpu": { "type": "number", "minimum": 0, "maximum": 100 },
    "memoria": { "type": "number", "minimum": 0, "maximum": 100 },
    "disco": { "type": "number", "minimum": 0, "maximum": 100 },
    "servicos": { "type": "object", "propertyNames": { "minLength": 1, "maxLength": 100 }, "additionalProperties": { "type": "boolean" } },
    "latencia": { "type": "number", "minimum": 0, "maximum": 600000 }
  }
}
