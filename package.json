{
  "name": "monitor-filiais",
  "version": "1.0.0",
  "description": "Monitor de filiais: API, painel, agente PowerShell e simulador.",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test api/test/*.test.ts",
    "start": "tsx api/src/index.ts",
    "cadastrar": "tsx api/src/cadastrar.ts",
    "typecheck": "tsc --noEmit --module commonjs --target es2022 --esModuleInterop --skipLibCheck api/src/*.ts",
    "painel": "vite --config painel/vite.config.ts",
    "build:painel": "vite build --config painel/vite.config.ts",
    "typecheck:painel": "tsc --noEmit --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 --esModuleInterop --skipLibCheck --lib es2022,dom painel/src/*.ts painel/src/*.tsx",
    "simular": "tsx simulador/src/index.ts",
    "cadastrar:simulador": "tsx simulador/src/cadastrar.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hey-Pablo/monitor-filiais.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Hey-Pablo/monitor-filiais/issues"
  },
  "homepage": "https://github.com/Hey-Pablo/monitor-filiais#readme",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
